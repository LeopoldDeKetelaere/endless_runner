# Kopieer dit bestand naar .env.local en vul de waarden in (die staan in de Firebase-console:
# Projectinstellingen > Algemeen > Jouw apps > Web-app > SDK-configuratie).
# .env.local staat in .gitignore en komt dus NOOIT in Git.
# Op Vercel voeg je dezelfde namen toe onder Settings > Environment Variables.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Alleen voor lokaal testen met de Firebase-emulator (leeg laten in het echt):
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
